# ==========================================
# HIRING RADAR - Environment Variables
# ==========================================

# Set to "true" for a safe, public read-only showcase deployment (no secrets allowed)
DEMO_MODE="false"

# Neon Postgres Connection URL (use pooled connection string for serverless)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (Auth.js v5 Google OAuth - Single Owner) ---
# The only Google email allowed to sign in
OWNER_EMAIL="owner@example.com"

# Generate with `openssl rand -base64 33` or `npx auth secret`
AUTH_SECRET="generate_a_random_base64_secret"

# Google Cloud OAuth 2.0 Credentials (Web application)
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID="your_google_oauth_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_oauth_client_secret"

# --- Pipeline & Automation Secrets ---
# SerpApi API Key (Free plan: 250 searches/month)
SERPAPI_KEY="your_serpapi_api_key_here"

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Secret token required in header: "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="generate_a_random_cron_secret"

# Email Configuration (Nodemailer + Gmail App Password or Resend)
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_16_char_app_password"
# Optional: defaults to "Hiring Radar" <SMTP_USER> if left as Hiring Radar
MAIL_FROM="Hiring Radar <your_email@gmail.com>"
MAIL_TO="your_email@gmail.com"

# Optional: Set RESEND_API_KEY if choosing Resend over Nodemailer
# RESEND_API_KEY="re_..."

# Pipeline Thresholds & Settings
SEARCH_NUM="20"
MAX_QUERIES_PER_RUN="8"
MAX_POST_AGE_DAYS="5"
MIN_SCORE="6"
ALWAYS_SEND="false"

# Development & Testing Flags
# Set DRY_RUN="true" to read from fixtures/sample-results.json without burning API quota
DRY_RUN="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
